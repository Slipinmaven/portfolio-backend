APP_NAME=Jasper's Portfolio
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
TIMEZONE=UTC
MEDIA_DIRECTORY=media
MEDIA_STORAGE_PROVIDER=local
# Keep the secret key server-side; never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=portfolio-media
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_DOCUMENT_MAX_BYTES=26214400
MEDIA_VIDEO_MAX_BYTES=52428800
MEDIA_VIDEO_MAX_DURATION_SECONDS=60
MEDIA_VIDEO_PROCESSING_TIMEOUT_SECONDS=600
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_FFPROBE_BINARY=ffprobe

# Use a local development database and replace the placeholder credentials.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/portfolio
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=7
SESSION_IDLE_MINUTES=60
SESSION_ACTIVITY_UPDATE_SECONDS=300
TRUSTED_DEVICE_DAYS=30
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW_MINUTES=15

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Comma-separated browser origins. Include the exact frontend origin.
CORS_ORIGINS=http://localhost:3000
